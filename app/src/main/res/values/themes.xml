<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="Theme.SPICaMusic" parent="android:Theme.Material.Light.NoActionBar">
    <!-- Keep the launcher visible until Compose has drawn its first real frame. -->
    <item name="android:windowDisablePreview">true</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>

  <!--
    Xiaomi OS 3 still creates an opaque Android 12+ starting card after aggressive memory
    cleanup even when windowDisablePreview is set. Making only the manifest launch theme
    translucent prevents that card; MainActivity switches back to Theme.SPICaMusic before its
    real window is created.
  -->
  <style name="Theme.SPICaMusic.Starting" parent="Theme.SPICaMusic">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowDisablePreview">true</item>
    <item name="android:backgroundDimEnabled">false</item>
  </style>

  <style name="Theme.SPICaMusic.Transparent" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:backgroundDimEnabled">false</item>
  </style>
</resources>
